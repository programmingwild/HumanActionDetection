{
  "name": "ActionScope",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "ActionScope app", "onAutoForward": "notify", "visibility": "public" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/serve.sh",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
